#! /bin/bash
# Sessão KYBER.
#
# Este arquivo NÃO é executado: o gamescope-session-plus (ChimeraOS) faz source
# dele dentro de `set -a`, sobe o gamescope, e roda $CLIENTCMD lá dentro. Nosso
# trabalho aqui é só definir o ambiente e o comando do cliente.
#
# Não definimos SCREEN_WIDTH/SCREEN_HEIGHT de propósito: o gamescope usa a
# resolução nativa do painel e o launcher se adapta sozinho por transform:
# scale() sobre um palco de 1920×1080. Fixar a resolução aqui só criaria uma
# segunda escala em cima da que já existe.

KYBER_URL="http://127.0.0.1:8787/"

# Fedora entrega o binário como chromium-browser e costuma criar o symlink
# chromium. Resolver os dois evita uma sessão que morre por PATH.
KYBER_BROWSER="$(command -v chromium || command -v chromium-browser)"

# O default do gamescope-session-plus termina em `--steam`, hardcoded e sem
# variável que o desligue (gamescope-session-plus:266). Com essa flag o
# gamescope só compõe janelas que carregam a propriedade STEAM_GAME — o KYBER
# não é a Steam, e o resultado era tela preta com a sessão viva por trás.
#
# Definir GAMESCOPECMD aqui não é patch: o script só monta o default quando a
# variável chega vazia (linha 165), então este é o ponto de extensão previsto.
# O `-R`/`-T` do socket de controle é anexado depois, fora daquele bloco
# (linha 270), de modo que nada da conversa com o gamescope se perde.
#
# Resolução fica de fora deliberadamente: o launcher se adapta por
# transform: scale(). Só respeitamos SCREEN_WIDTH/HEIGHT quando o device-quirks
# do próprio Bazzite os definiu para este hardware (sourced na linha 117, antes
# deste arquivo), para não quebrar handhelds que dependem deles.
: "${OUTPUT_CONNECTOR:=*,eDP-1}"
: "${XWAYLAND_COUNT:=2}"
: "${TOUCH_MODE:=4}"
: "${HIDE_CURSOR_DELAY_MS:=3000}"
: "${FADE_OUT_DURATION_MS:=200}"

KYBER_RESOLUTION=""
if [ -n "${SCREEN_WIDTH}" ] && [ -n "${SCREEN_HEIGHT}" ]; then
    KYBER_RESOLUTION="-W ${SCREEN_WIDTH} -H ${SCREEN_HEIGHT}"
fi

GAMESCOPECMD="$(get_gamescope_binary) \
${KYBER_RESOLUTION} \
--prefer-output ${OUTPUT_CONNECTOR} \
--xwayland-count ${XWAYLAND_COUNT} \
--default-touch-mode ${TOUCH_MODE} \
--hide-cursor-delay ${HIDE_CURSOR_DELAY_MS} \
--fade-out-duration ${FADE_OUT_DURATION_MS}"

short_session_recover() {
    # A sessão morreu rápido demais — provavelmente o navegador não subiu.
    # Cair no desktop é melhor que entrar em laço de boot: um console que não
    # abre precisa deixar um caminho de conserto aberto.
    #
    # `plasma`, e não `desktop`. O argumento estava ERRADO desde que esta
    # função existe: o steamos-session-select do Bazzite tem lista fechada de
    # sessões — plasma, plasma-wayland, plasma-x11-persistent,
    # plasma-wayland-persistent, gamescope — e mais nada. `desktop` caía no
    # `*)` do case, imprimia "Unrecognized session" num stderr que ninguém lia
    # e saía 1. A saída de emergência não existia; ela só parecia existir.
    #
    # `plasma` (e não a variante -persistent) porque a fuga é para CONSERTAR:
    # a persistente grava /etc/bazzite/desktop_autologin e o console pararia
    # de voltar sozinho no boot seguinte — trocaria um laço por um exílio.
    if command -v steamos-session-select > /dev/null; then
        steamos-session-select plasma || \
            echo "kyber: steamos-session-select plasma falhou ($?)" >&2
    fi
}

post_gamescope_start() {
    # O gamescope-session-plus publica o display do gamescope apenas como
    # GAMESCOPE_WAYLAND_DISPLAY (gamescope-session-plus:301) e nunca exporta
    # WAYLAND_DISPLAY. Cliente Wayland que procure o nome padrão não acha nada,
    # morre com "Failed to connect to Wayland display" e derruba a sessão de
    # volta para o login. Só dá para fazer isso aqui: no corpo do arquivo a
    # variável ainda não existe, porque o gamescope só reporta seu display pelo
    # socket depois de subir, e este gancho roda logo em seguida (linha 312).
    export WAYLAND_DISPLAY="${GAMESCOPE_WAYLAND_DISPLAY}"

    # Espera o kyber-launcher.service responder antes de abrir o navegador.
    # Sem isto, a primeira tela do console pode ser um erro de conexão do
    # Chromium — que é exatamente a impressão que não queremos causar no boot.
    local tentativa
    for tentativa in $(seq 1 50); do
        curl -sf -o /dev/null "${KYBER_URL}" && return 0
        sleep 0.1
    done
    echo "kyber: servidor local não respondeu em 5 s" >&2
}

# --kiosk já implica tela cheia e sem barra de navegação. O resto suprime o que
# um console nunca deve mostrar: diálogo de erro, balão de "sessão anterior
# encerrada", barra de tradução e navegação por gesto de overscroll.
#
# x11, não wayland: o gamescope roda XWayland por dentro e exporta DISPLAY
# (gamescope-session-plus:300). Pelo backend Wayland o Chromium ignorava o
# --kiosk e abria janelado, com barra de endereço e aba — é o comportamento
# descrito em ValveSoftware/gamescope#1356, onde fullscreen de janela dentro do
# gamescope quebra nesse backend. Trocar o backend sozinho resolve; nenhuma
# flag adicional de janela foi necessária.
export CLIENTCMD="${KYBER_BROWSER} \
--kiosk \
--ozone-platform=x11 \
--no-first-run \
--noerrdialogs \
--disable-session-crashed-bubble \
--disable-features=TranslateUI \
--overscroll-history-navigation=0 \
--autoplay-policy=no-user-gesture-required \
${KYBER_URL}"
